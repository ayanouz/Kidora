# ══════════════════════════════════════════════════════════════════
#  KIDORA — Variables d'environnement
#  Copier ce fichier vers .env À LA RACINE du dépôt, puis remplir.
#  (PowerShell : Copy-Item .env.example .env)
#  NE JAMAIS COMMITTER le fichier .env réel.
# ══════════════════════════════════════════════════════════════════

# ── Application ───────────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# URLs publiques (utilisées pour CORS, cookies, liens emails)
FRONTEND_URL=http://localhost:5173
API_URL=http://localhost:4000

# ── Base de données PostgreSQL ────────────────────────────────────
# En local (hors docker) : postgresql://kidora:motdepasse@localhost:5432/kidora
# Dans docker compose : host = postgres
DATABASE_URL=postgresql://kidora:change-me-db-password@localhost:5432/kidora

# Utilisé par le conteneur postgres de docker-compose
POSTGRES_DB=kidora
POSTGRES_USER=kidora
POSTGRES_PASSWORD=change-me-db-password

# ── Secrets (GÉNÉRER avec : openssl rand -base64 48) ──────────────
JWT_SECRET=change-me-to-a-long-random-string-at-least-64-chars-xxxxxxxxxxxxxxxx
SESSION_SECRET=change-me-to-another-long-random-string-at-least-64-chars-yyyyyyy

# Durées de vie des sessions
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
PASSWORD_RESET_TTL_MINUTES=30

# ── Cookies ───────────────────────────────────────────────────────
# true en production (HTTPS obligatoire), false en local et en docker
# sur http://localhost (les navigateurs refusent les cookies Secure en http)
COOKIE_SECURE=false
COOKIE_DOMAIN=

# ── Rate limiting ─────────────────────────────────────────────────
RATE_LIMIT_MAX=200
AUTH_RATE_LIMIT_MAX=10

# ── Anti-cheat / sessions de jeu ──────────────────────────────────
# Nombre maximal de sessions terminées par profil et par heure
MAX_SESSIONS_PER_HOUR=60

# ── Emails (mot de passe oublié) ──────────────────────────────────
# En développement : les liens de reset sont écrits dans les logs.
# En production : configurer un SMTP (ou un provider compatible).
MAIL_FROM="Kidora <no-reply@kidora.example>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# true = ne pas envoyer, seulement logguer (dev)
MAIL_DRY_RUN=true

# ── Abonnements Premium (Stripe) ──────────────────────────────────
# Sans clé Stripe, le mode démo (activé par défaut hors production)
# permet de tester l'activation d'un abonnement sans paiement réel.
# En production : renseigner STRIPE_SECRET_KEY et les Price IDs.
STRIPE_SECRET_KEY=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=
STRIPE_PRICE_FAMILY=
# true / false. Vide = true hors production, false en production.
BILLING_DEMO=

# ── Nginx / domaine (production) ──────────────────────────────────
DOMAIN=kidora.example
